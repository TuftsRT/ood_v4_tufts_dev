# file path: ---

OOD_BRAND_BG_COLOR="#c1a226" 
OOD_LOAD_EXTERNAL_CONFIG=1 
OOD_CONFIG_D_DIRECTORY="/home/hpcadmin/ondemand/config/ondemand.d"
OOD_APP_CONFIG_ROOT="/home/hpcadmin/ondemand/config" 
OOD_APP_SHARING=true

# this supports both file and RSS feed 
MOTD_PATH="/home/hpcadmin/ondemand/dev/dashboard/public/motd" 
MOTD_FORMAT="markdown" # markdown, txt, rss, markdown_erb, txt_erb 
SHOW_ALL_APPS_LINK=1 

OOD_BALANCE_PATH="example-path/path/to/balance1.json:/path/to/balance2.json"
OOD_BALANCE_THRESHOLD=50 

OOD_QUOTA_PATH="example-path/path/to/quota1.json:/path/to/quota2.json"
OOD_QUOTA_THRESHOLD=0.95
