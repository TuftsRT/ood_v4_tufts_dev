---
cluster: "pax"
bc_dynamic_js: true

<%
# -----------------
# GPU dynamic logic
# -----------------
require 'open3'
require 'set'

def capture_stdout(cmd)
  stdout, status = Open3.capture2(cmd)
  status.success? ? stdout : ''
end

nodes_out = capture_stdout('scontrol show node --oneliner')

detected_types = Set.new
a100_sizes     = Set.new

nodes_out.each_line do |line|
  if (m = line.match(/\bGres=gpu:(\w+)/))
    type = m[1]
    detected_types << type if type && type != 'null'
  end

  feats_available = line[/\bAvailableFeatures=(\S+)/, 1]
  feats_active    = line[/\bActiveFeatures=(\S+)/, 1]
  feats_legacy    = line[/\bFeature(?:s)?=(\S+)/, 1]
  feats = [feats_available, feats_active, feats_legacy].compact.join(',')
  a100_sizes << 'a100_40' if feats.include?('a100-40G')
  a100_sizes << 'a100_80' if feats.include?('a100-80G')
end

dynamic_failed = detected_types.empty?
detected_types.delete('a100') unless a100_sizes.empty?

label_map = {
  'h200'        => 'H200 - 140GB',
  'h100'        => 'H100 - 80GB',
  'a100'        => 'A100',
  'a100_40'     => 'A100 - 40GB',
  'a100_80'     => 'A100 - 80GB',
  'l40s'        => 'L40S - 48GB',
  'l40'         => 'L40 - 48GB',
  'rtx_6000ada' => 'RTX 6000Ada - 48GB',
  'rtx_a6000'   => 'RTX A6000 - 48GB',
  'rtx_6000'    => 'RTX 6000 - 24GB',
  'v100'        => 'v100 - 16GB',
  'p100'        => 'P100 - 16GB',
  't4'          => 'T4 - 16GB'
}

order = %w[h200 h100 a100_80 a100_40 a100 l40s l40 rtx_6000ada rtx_a6000 rtx_6000 v100 p100 t4]
priority = order.each_with_index.to_h

options = []
options << ['none', 'none']
options << ['any',  'any']
options << [label_map['a100_40'], 'a100_40'] if a100_sizes.include?('a100_40')
options << [label_map['a100_80'], 'a100_80'] if a100_sizes.include?('a100_80')

remaining = detected_types.to_a
remaining.sort_by! { |t| priority.fetch(t, 999) }
remaining.each do |t|
  next if %w[a100_40 a100_80].include?(t)
  label = label_map[t] || t.upcase
  options << [label, t]
end
%>

attributes:
  conda_extensions: "0"
  extra_jupyter_args: ""
  
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/num_cores_generic.yml").indent(2) %>
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/num_memory_generic.yml").indent(2) %>
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/all_partition.yml").indent(2) %>

  global_components:
    widget: "text_field"
    value: ""
    help: |
      <style>
        <%= File.read("/cluster/home/wgoldm03/ondemand/prod/global_css/base.css").indent(6) %>
        <%= File.read("/cluster/home/wgoldm03/ondemand/prod/global_css/buttons.css").indent(6) %>
        <%= File.read("/cluster/home/wgoldm03/ondemand/prod/global_css/tooltip.css").indent(6) %>
        <%= File.read("/cluster/home/wgoldm03/ondemand/prod/global_css/form.css").indent(6) %>
        <%= File.read("/cluster/home/wgoldm03/ondemand/prod/global_css/jupyter.css").indent(6) %>
      </style>

  working_directory:
    widget: "text_field"
    label: "Top working directory"
    help: Top working directory for your Jupyter session to access your notebooks and data. Default is your **$HOME**.

  module:
    widget: "text_field"
    label: "Load supporting modules"
    help: ENTER module name **ONLY**. e.g. for "module load cuda/12.9" in command line, ENTER **cuda/12.9**

  bc_num_hours:
    label: "# Hours"
    <%= ERB.new(File.read("/cluster/home/wgoldm03/ondemand/prod/global_components/tooltip.yml.erb"))
      .result_with_hash(tooltip_text: "Amount of time you believe the program will need.") %>

  num_cores:
    label: "# Cores"
    widget: "number_field"
    value: 1
    min: 1
    max: 64
    <%= ERB.new(File.read("/cluster/home/wgoldm03/ondemand/prod/global_components/tooltip.yml.erb"))
      .result_with_hash(tooltip_text: "Select the number of CPU cores for your job. Most jobs use 1-4.") %>

  num_memory:
    label: "GB Memory"
    <%= ERB.new(File.read("/cluster/home/wgoldm03/ondemand/prod/global_components/tooltip.yml.erb"))
      .result_with_hash(tooltip_text: "Enter the memory amount in GB (e.g., 12 for 12GB or 100 for 100GB).") %>

  mode:
    widget: "radio"
    label: "Jupyter Lab or Notebook?"
    value: "1"
    options:
      - ["Jupyter Lab", "1"]
      - ["Jupyter Notebook", "0"]
    help: |
      <script>
        const label = document.querySelector('label[for="batch_connect_session_context_mode_1"]');
        const label1 = document.querySelector('label[for="batch_connect_session_context_mode_0"]');

        if (label && label1) {
          label.innerHTML = `<img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/38/Jupyter_logo.svg/1767px-Jupyter_logo.svg.png" alt="jupyter" class="img_icon">`;
          label1.innerHTML = `<img src="https://user-images.githubusercontent.com/7244206/224844987-30e9b7c5-abb1-416d-9e3d-63dc8ce9d532.png" alt="jupyter_lab" class="img_icon">`;
        }
      </script>

  working_directory_path:
    widget: "path_selector"
    label: "📁 Select Working Directory"
    help: |
      <div class="resource-item">
        <div class="resource-label">
          <i class="fas fa-folder-open"></i>
          Working Directory
        </div>
        <p>Browse and select your working directory using the built-in path selector.</p>
      </div>
    directory: "<%= ENV['HOME'] %>"
    show_hidden: false
    show_files: false
    favorites:
      - "<%= ENV['HOME'] %>"
      - "<%= ENV['HOME'] %>/projects"
      - "/tmp"

  gpu_type:
    widget: "select"
    label: "GPU architecture"
    help: "<%= dynamic_failed ? 'Failed to dynamically obtain GPU options from Slurm. Showing minimal defaults (none/any).' : "Auto-detected GPUs: #{detected_types.to_a.join(', ')}. Sizes: #{a100_sizes.to_a.join(', ')}." %>"
    options:
<% options.each do |label, value| %>
      - [ "<%= label %>", "<%= value %>" ]
<% end %>

form:
  - conda_extensions
  - extra_jupyter_args
  - global_components
  - mode
  - bc_num_hours
  - num_cores
  - num_memory
  - partition
  - gpu_type
  - working_directory
  - working_directory_path
  - module
